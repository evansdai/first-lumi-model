def parse_args(argv: List[str]) -> Options:
    parser = argparse.ArgumentParser(
        prog=TOOL,
        description=(
            "Build the packages a base container is missing into one SquashFS layer, refusing "
            "anything that would shadow the image's own stack. See MANUAL.md."
        ),
        epilog="exit codes: 0 ok, 2 usage/input, 3 conflict, 4 build/verify, 5 environment",
    )
    parser.add_argument("--base", required=True, help="the pinned base image (.sif)")
    parser.add_argument(
        "--base-sha256", metavar="FILE",
        help="a `sha256sum -c` file for --base; a mismatch stops the build (see step 2)",
    )
    parser.add_argument(
        "--env", dest="env_file", required=True,
        help="the environment: environment.yml, `conda env export --json`, or `conda list --json`",
    )
    parser.add_argument("--id", dest="layer_id", help="layer id (default: <env name>-<date>)")
    parser.add_argument("--out", default=".", help="directory for the .sqsh (default: .)")
    parser.add_argument("--python", default="python", help="interpreter inside the image (default: python)")
    parser.add_argument(
        "--allow-shadow", action="append", default=[], metavar="PKG",
        help="install PKG even though the image has a different version (recorded in the manifest)",
    )
    parser.add_argument("--dry-run", action="store_true", help="plan and report; build nothing")
    parser.add_argument("--json", dest="as_json", action="store_true", help="machine-readable report")
    parser.add_argument(
        "--export-to", metavar="FILE",
        help="after publishing, point FILE's MODEL_LAYER line at the new layer",
    )
    parser.add_argument("--timeout", type=int, default=3600, help="seconds per command")
    parser.add_argument("--keep-stage", action="store_true", help="keep the staging directory")
    parser.add_argument("--version", action="version", version=f"{TOOL} {VERSION}")
    args = parser.parse_args(argv)

    if args.layer_id and (not LAYER_ID_RE.match(args.layer_id) or args.layer_id in (".", "..")):
        raise ToolError(
            f"invalid --id {args.layer_id!r}: letters, digits, dot, underscore or dash only "
            "(it becomes a file name)",
            EXIT_USAGE,
        )
    if not args.layer_id:
        name, _ = parse_environment(read_env_file(args.env_file), args.env_file)
        args.layer_id = f"{name or 'layer'}-{datetime.now(timezone.utc).strftime('%Y%m%d')}"
        if not LAYER_ID_RE.match(args.layer_id):
            raise ToolError(f"cannot derive a layer id from {args.env_file!r}; pass --id", EXIT_USAGE)
    return Options(
        base=args.base,
        env_file=args.env_file,
        layer_id=args.layer_id,
        out=args.out,
        python=args.python,
        allow_shadow=args.allow_shadow,
        dry_run=args.dry_run,
        as_json=args.as_json,
        export_to=args.export_to,
        base_sha256=args.base_sha256,
        timeout=args.timeout,
        keep_stage=args.keep_stage,
    )


def print_report(report: Dict, as_json: bool, plan: Optional[Plan]) -> None:
    if as_json:
        print(json.dumps(report, indent=2, sort_keys=True))
        return
    print(f"{TOOL} {VERSION}")
    print(f"  base        {report['base_image']}")
    print(f"  environment {report['env_file']}  ({report['image_packages']} packages in the image)")
    print(f"  satisfied   {', '.join(report['satisfied']) or '(none)'}")
    print(f"  to install  {', '.join(report['missing']) or '(none)'}")
    if report.get("allowed_shadow"):
        print(f"  allowed     {', '.join(report['allowed_shadow'])} (shadowing on purpose)")
    for conflict in report["conflicts"]:
        print(f"  CONFLICT    {conflict['package']} [{conflict['kind']}] {conflict['why']}")
    if report.get("status") == "built":
        print(f"  published   {report['artifacts']['layer']}")
        print(f"  manifest    {report['artifacts']['manifest']}")
    if "export_to" in report:
        where = report["export_to"]
        print(f"  env file    {where['detail'] if where['ok'] else 'NOT updated: ' + where['detail']}")
    if plan and plan.missing:
        layer = report.get("artifacts", {}).get("layer", "<layer>.sqsh")
        print("\nMount it in a job (the layer appears at /user-software):")
        print("  singularity exec --no-home -B <repo>:/workspace:ro \\")
        print(f"    -B {layer}:/user-software:image-src=/ \\")
        print(f"    {report['base_image']} /user-software/bin/python <script>")


def main(argv: List[str]) -> int:
    try:
        options = parse_args(argv)
    except ToolError as exc:
        print(f"{TOOL}: error: {exc}", file=sys.stderr)
        return exc.code
    except SystemExit as exc:  # argparse: --help, --version, or a usage error
        return int(exc.code or 0)
    except ValueError as exc:  # a malformed environment file, read to derive the layer id
        print(f"{TOOL}: error: {exc}", file=sys.stderr)
        return EXIT_USAGE

    if in_container():
        print(
            f"{TOOL}: error: this is running inside a container, which has no singularity. "
            "Containers do not nest on LUMI -- run this in a plain login shell.",
            file=sys.stderr,
        )
        return EXIT_ENVIRONMENT
    for tool in ("singularity", "mksquashfs", "sha256sum"):
        if not shutil.which(tool):
            print(f"{TOOL}: error: no {tool} on PATH", file=sys.stderr)
            return EXIT_ENVIRONMENT

    try:
        plan, report = build(options)
    except Conflicts as exc:
        print_report(exc.report, options.as_json, exc.plan)
        print(f"{TOOL}: {exc}", file=sys.stderr)
        return EXIT_CONFLICT
    except ToolError as exc:
        print(f"{TOOL}: error: {exc}", file=sys.stderr)
        return exc.code
    except ValueError as exc:
        print(f"{TOOL}: error: {exc}", file=sys.stderr)
        return EXIT_USAGE
    print_report(report, options.as_json, plan)
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
