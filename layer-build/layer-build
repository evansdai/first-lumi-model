class ToolError(Exception):
    """A failure with an exit code and a message meant for a human or an agent."""

    def __init__(self, message: str, code: int = EXIT_BUILD):
        super().__init__(message)
        self.code = code


def read_env_file(path: str) -> str:
    """Read the environment file, or stop with a usage error: a missing file is not a traceback."""
    try:
        return Path(path).read_text()
    except OSError as exc:
        raise ToolError(f"cannot read {path}: {exc}", EXIT_USAGE) from exc


def run(argv: List[str], *, timeout: int = 3600) -> str:
    try:
        completed = subprocess.run(
            argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            universal_newlines=True, timeout=timeout, check=False,
        )
    except FileNotFoundError as exc:
        raise ToolError(f"{argv[0]} not found on PATH", EXIT_ENVIRONMENT) from exc
    except subprocess.TimeoutExpired as exc:
        raise ToolError(f"timed out after {timeout}s: {' '.join(argv)}") from exc
    if completed.returncode != 0:
        detail = (completed.stderr or completed.stdout).strip()
        raise ToolError(f"command failed ({completed.returncode}): {' '.join(argv)}\n{detail}")
    return completed.stdout


def in_container() -> bool:
    """True inside a container, where singularity cannot start another one."""
    return bool(os.environ.get("SINGULARITY_CONTAINER") or os.environ.get("APPTAINER_CONTAINER"))


def image_packages(base: str, python: str) -> Dict[str, str]:
    """What the image already has, as normalized package name -> version."""
    raw = run(["singularity", "exec", "--no-home", base, python, "-m", "pip", "list", "--format=json"])
    try:
        listed = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise ToolError(f"`pip list --format=json` inside the image was not JSON: {exc}") from exc
    packages = {}  # type: Dict[str, str]
    for entry in listed:
        packages[normalize_name(entry["name"])] = entry.get("version", "")
    if not packages:
        raise ToolError("the image reported no packages -- refusing to plan against an empty list")
    return packages


def pip_check_failed(returncode: int) -> bool:
    """`pip check` exits 1 when it FINDS conflicts, which is data; anything else is an error."""
    return returncode not in (0, 1)


def pip_check(base: str, python: str, layer: Optional[str]) -> str:
    """`pip check` for the image alone, or for the image with the layer mounted at /user-software.

    `pip check` exits 1 when it *finds* conflicts, and the AI image has pre-existing ones by that
    standard (it ships vllm and a compressed-tensors that vllm's metadata disagrees with). Exit 1 is
    therefore data to compare, not a failure; any other status is a real error.
    """
    argv = ["singularity", "exec", "--no-home"]
    if layer is not None:
        argv += ["-B", f"{layer}:/user-software:image-src=/"]
    argv += [base, python, "-m", "pip", "check"]
    try:
        completed = subprocess.run(
            argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            universal_newlines=True, timeout=900, check=False,
        )
    except FileNotFoundError as exc:
        raise ToolError(f"{argv[0]} not found on PATH", EXIT_ENVIRONMENT) from exc
    except subprocess.TimeoutExpired as exc:
        raise ToolError(f"timed out after 900s: {' '.join(argv)}") from exc
    if pip_check_failed(completed.returncode):
        raise ToolError(
            f"`pip check` failed ({completed.returncode}): {' '.join(argv)}\n"
            f"{(completed.stderr or completed.stdout).strip()}"
        )
    return completed.stdout or completed.stderr


def check_regressions(before: str, after: str) -> None:
    """Compare `pip check` with and without the layer. The image's own noise is not ours.

    The AI image is inconsistent by `pip check`'s own standard before any layer exists (it ships
    vllm and a compressed-tensors that vllm's metadata disagrees with). Asking differentially is
    what makes the question answerable: did *our* packages add a conflict?
    """
    known = {line for line in before.splitlines() if line.strip()}
    new_lines = [line for line in after.splitlines() if line.strip() and line not in known]
    if new_lines:
        raise ToolError(
            "the layer would add dependency conflicts the image alone does not have:\n  "
            + "\n  ".join(new_lines)
            + "\n(the image's own pre-existing conflicts are not counted -- see MANUAL.md)",
            EXIT_CONFLICT,
        )


def import_probe(names: List[str]) -> str:
    """A program that imports every requested distribution, by the names it actually provides.

    The distribution-to-module mapping comes from the layer's own metadata, so nothing here is
    specific to any one package or example. A distribution whose modules cannot be found is a
    failure: an unverifiable install is not a verified one.
    """
    return (
        "import importlib, importlib.metadata as md, re, sys\n"
        f"names = {names!r}\n"
        "def norm(n):\n"
        "    return re.sub(r'[-_.]+', '-', n).strip().lower()\n"
        "dist_to_modules = {}\n"
        "for module, dists in md.packages_distributions().items():\n"
        "    for dist in dists:\n"
        "        dist_to_modules.setdefault(norm(dist), []).append(module)\n"
        "bad = []\n"
        "for name in names:\n"
        "    modules = dist_to_modules.get(norm(name))\n"
        "    if not modules:\n"
        "        bad.append(f'{name}: installed, but reports no importable module')\n"
        "        continue\n"
        "    for module in sorted(set(modules)):\n"
        "        try:\n"
        "            importlib.import_module(module)\n"
        "        except Exception as exc:\n"
        "            bad.append(f'{name} -> {module}: {exc!r}')\n"
        "print('\\n'.join(bad))\n"
        "sys.exit(1 if bad else 0)\n"
    )


