TOOL = "layer-build"
VERSION = "0.1.0"

# Exit codes are part of the interface: a caller -- human or agent -- branches on them.
EXIT_OK = 0
EXIT_USAGE = 2
EXIT_CONFLICT = 3
EXIT_BUILD = 4
EXIT_ENVIRONMENT = 5

# Packages a venv built with --system-site-packages can only *shadow*, never replace. Installing
# one into the layer is how a working ROCm job breaks: the image's torch is compiled against the
# image's own numpy and its own ROCm runtime.
STACK_PACKAGES = (
    "torch",
    "torchvision",
    "torchaudio",
    "pytorch-triton",
    "triton",
    "numpy",
    "scipy",
    "pandas",
    "matplotlib",
    "h5py",
    "scikit-learn",
    "tensorboard",
    "transformers",
    "vllm",
    "numba",
    "llvmlite",
    "pyarrow",
)

# Not installable into a layer at all: these ARE the image's runtime. Asking for one is a request
# for a different container, not for a layer.
NON_LAYERABLE = (
    "python", "pip", "setuptools", "wheel", "conda", "mamba", "virtualenv",
    # conda's own compiler-runtime packages: never on PyPI, and always in a resolved export.
    # Listed normalized, because that is what the comparison uses.
    "libgcc-ng", "libstdcxx-ng", "libgomp", "ld-impl-linux-64",
)

# A layer id becomes a file name and a directory name, so it is restricted to what is safe there.
LAYER_ID_RE = re.compile(r"^[A-Za-z0-9._-]+$")

NAME_RE = re.compile(r"^([A-Za-z0-9_][A-Za-z0-9._+-]*)\s*(.*)$")  # `_libgcc_mutex` is a real name


# --------------------------------------------------------------------------------------
# pure logic: requirements, versions, classification
# --------------------------------------------------------------------------------------


class Requirement(NamedTuple):
    """One package the environment asks for. `spec` is a pip specifier, or "" for "any"."""

    name: str
    spec: str = ""
    source: str = "conda"  # "conda" or "pip"

    @property
    def key(self) -> str:
        """The normalized (PEP 503) name: how the two sides of the comparison are matched."""
        return normalize_name(self.name)


class Conflict(NamedTuple):
    """A request this tool refuses, with the reason a reader needs in order to act on it."""

    package: str
    kind: str  # non-pip | shadow-stack | version-drift | stack-drift | pip-check
    requested: str
    image_version: str
    why: str

    def as_dict(self) -> Dict[str, str]:
        return {
            "package": self.package,
            "kind": self.kind,
            "requested": self.requested,
            "image_version": self.image_version,
            "why": self.why,
        }


class Plan(object):
    """The decision: what the image satisfies, what to install, what is refused."""

    def __init__(self):
        self.satisfied = []  # type: List[Tuple[Requirement, str]]
        self.missing = []  # type: List[Requirement]
        self.conflicts = []  # type: List[Conflict]
        self.allowed_shadow = []  # type: List[str]

    def installable(self) -> List[str]:
        """The pip arguments for the install step: only what the image does not satisfy."""
        return [f"{r.name}{r.spec}" for r in self.missing]


def normalize_name(name: str) -> str:
    """PEP 503: case-insensitive, and runs of -_. collapse to a single -."""
    return re.sub(r"[-_.]+", "-", name).strip().lower()


def version_key(version: str) -> tuple:
    """A comparable key: (release as written, (pre/post rank, serial), local label)."""
    core, _, local = version.partition("+")
    core, _, post = core.partition(".post")
    match = re.match(r"^(?P<release>[0-9][0-9.]*)(?P<pre>.*)$", core)
    if not match:
        return ((), (0, 0), local)
    release = tuple(int(part) for part in match.group("release").rstrip(".").split("."))
    pre = match.group("pre")
    rank, serial = 0, 0
    if pre:
        word = re.match(r"^[A-Za-z]+", pre)
        rank = {"dev": -4, "a": -3, "b": -2, "rc": -1, "c": -1}.get(
            word.group(0).lower() if word else "", -1
        )
        digits = re.search(r"(\d+)", pre)
        serial = int(digits.group(1)) if digits else 0
    if post:
        rank = 1
        digits = re.search(r"(\d+)", post)
        serial = int(digits.group(1)) if digits else 0
    return (release, (rank, serial), local)


def compare_versions(a: tuple, b: tuple) -> int:
    """Order two keys: -1, 0 or 1. The release is padded with zeros, and the local label is
    ignored -- `1.0`, `1.0.0` and the image's `2.10.0+rocm7.0` compare as the release they are."""
    width = max(len(a[0]), len(b[0]))
    left = a[0] + (0,) * (width - len(a[0]))
    right = b[0] + (0,) * (width - len(b[0]))
    if left != right:
        return -1 if left < right else 1
    if a[1] != b[1]:
        return -1 if a[1] < b[1] else 1
    return 0


def same_version(have: tuple, want: tuple) -> bool:
    """Equality, including the local label when the *specifier* names one.

    A specifier without a local label (`==2.10.0`) therefore matches the image's ROCm build
    (`2.10.0+rocm7.0`), which is what a LUMI user means; `==1.0+cpu` does not match `1.0+rocm`.
    """
    if compare_versions(have, want) != 0:
        return False
    return not want[2] or have[2] == want[2]


def satisfies(version: str, spec: str) -> bool:
    """Does `version` satisfy a comma-separated clause list? An empty spec means "any"."""
    if not spec.strip():
        return True
    have = version_key(version)
    for clause in spec.split(","):
        clause = clause.strip()
        if not clause or clause == "*":
            continue
        for op in ("===", "==", "!=", ">=", "<=", "~=", ">", "<"):
            if clause.startswith(op):
                wanted = clause[len(op) :].strip()
                break
        else:
            op, wanted = "==", clause
        if wanted.endswith(".*"):
            prefix = version_key(wanted[:-2])[0]
            matches = have[0][: len(prefix)] == prefix
            if op in ("==", "==="):
                if not matches:
                    return False
                continue
            if op == "!=":
                if matches:
                    return False
                continue
            return False  # a range against a wildcard is not something we guess at
        want = version_key(wanted)
        order = compare_versions(have, want)
        if op in ("==", "===") and not same_version(have, want):
            return False
        if op == "!=" and same_version(have, want):
            return False
        if op == ">=" and order < 0:
            return False
        if op == "<=" and order > 0:
            return False
        if op == ">" and order <= 0:
            return False
        if op == "<" and order >= 0:
            return False
        if op == "~=":
            # PEP 440's compatible release: >= the version, and the same prefix up to its last
            # component *as written* -- so `~=1.4.0` allows 1.4.x and not 1.9.
            parts = want[0]
            if len(parts) < 2:
                return False  # `~=1` is not a compatible-release specifier
            prefix = parts[: len(parts) - 1]
            if order < 0 or have[0][: len(prefix)] != prefix:
                return False
    return True


CLAUSE_RE = re.compile(r"^(?P<op>===|==|!=|<=|>=|~=|=|<|>)?(?P<version>[0-9][A-Za-z0-9._*+!-]*)$")


def conda_spec_to_pip(rest: str) -> str:
    """The text after the package name in a conda entry, as a pip specifier.

    `=1.8.0` and ` 1.8.0` become `==1.8.0`; `=1.8` becomes `>=1.8,<1.9`, because conda's `=` is a
    prefix match; `>=1.0` is passed through; several clauses survive (`>=1,<2`). A build string
    (`=1.8.0=py312_0`) is dropped and a build glob (`=*=*pthreads*`) means "any version": pip has no
    way to express a build constraint, so the version is what gets compared, and MANUAL.md says so.

    Anything the grammar does not cover is an error. Truncating a constraint would *weaken* it --
    `numpy>=1,<2` silently becoming `>=1` is exactly the fail-open case this tool exists to prevent.
    """
    rest = rest.strip()
    if not rest or rest.startswith("*"):
        return ""
    converted = []  # type: List[str]
    for clause in rest.split(","):
        clause = clause.strip()
        if not clause:
            continue
        if clause.startswith("=*"):
            continue  # `=*=*pthreads*`: a build glob, which pip cannot express
        # `=1.8.0=py312_0` carries a build string; `==1.8.0` does not, so only the bare `=` form
        # gets its build field stripped.
        if clause.count("=") >= 2 and not clause.startswith(("==", "===", "!=", "<=", ">=", "~=")):
            clause = clause[: clause.index("=", clause.index("=") + 1)]
        match = CLAUSE_RE.match(clause)
        if not match:
            raise ValueError(f"cannot read this version constraint: {clause!r}")
        op, version = match.group("op"), match.group("version")
        if op in ("<", ">", "<=", ">=", "!=", "==", "===", "~="):
            converted.append(f"{op}{version}")
            continue
        if version.endswith(".*"):
            converted.append(f"=={version}")
            continue
        parts = version.split(".")
        if len(parts) >= 3:
            converted.append(f"=={version}")
            continue
        try:
            upper = parts[:-1] + [str(int(parts[-1]) + 1)]
        except ValueError:
            converted.append(f"=={version}")
            continue
        converted.append(f">={version},<{'.'.join(upper)}")
    return ",".join(converted)


def parse_requirement_line(line: str, source: str) -> Optional[Requirement]:
    """One entry: `name`, `name=1.8`, `name==1.8`, `name>=1.8,<2`, or `name 1.8 build`."""
    line = line.strip()
    if not line or line.startswith("#"):
        return None
    if ";" in line:
        raise ValueError(f"environment markers are not supported here: {line!r}")
    if "::" in line:
        line = line.split("::", 1)[1].strip()  # `conda-forge::numpy=1.26`: not our business
    match = NAME_RE.match(line)
    if not match:
        raise ValueError(f"cannot read this package line: {line!r}")
    name, rest = match.group(1), match.group(2).strip()
    rest = rest.split("#")[0].strip()  # a trailing comment
    if source == "pip":
        return Requirement(name=name, spec=rest, source=source)
    # `numpy 1.26.4 py312_0` is a resolved conda line: the first token is the version, the rest
    # is a build string, and a build string is not something pip can be told about.
    return Requirement(name=name, spec=conda_spec_to_pip(rest.split()[0] if rest else ""), source=source)


def parse_environment(text: str, origin: str) -> Tuple[str, List[Requirement]]:
    """Read `conda env export --json`, `conda list --json`, or an `environment.yml`.

    Returns (environment name, requirements). Raises ValueError when the input is a shape this
    parser does not cover: guessing here would build an environment nobody asked for, which is
    worse than stopping.
    """
    if text.lstrip().startswith(("{", "[")):
        return _parse_json_environment(text, origin)
    return _parse_yaml_environment(text, origin)


def _parse_json_environment(text: str, origin: str) -> Tuple[str, List[Requirement]]:
    try:
        data = json.loads(text)
    except json.JSONDecodeError as exc:
        raise ValueError(f"{origin}: not valid JSON: {exc}") from exc
    requirements = []  # type: List[Requirement]
    if isinstance(data, list):  # `conda list --json`: the resolved set
        for entry in data:
            if not isinstance(entry, dict) or "name" not in entry:
                raise ValueError(f"{origin}: expected a list of package objects")
            requirements.append(
                Requirement(
                    name=str(entry["name"]),
                    spec=f"=={entry['version']}" if entry.get("version") else "",
                    source="conda",
                )
            )
        return ("", requirements)
    if not isinstance(data, dict):
        raise ValueError(f"{origin}: expected an object or a list")
    dependencies = data.get("dependencies", [])
    if not isinstance(dependencies, list):
        raise ValueError(f"{origin}: `dependencies` must be a list")
    for entry in dependencies:
        if isinstance(entry, str):
            parsed = parse_requirement_line(entry, "conda")
            if parsed:
                requirements.append(parsed)
        elif isinstance(entry, dict) and "pip" in entry:
            if not isinstance(entry["pip"], list):
                raise ValueError(f"{origin}: the `pip` entry must be a list")
            for pip_line in entry["pip"]:
                if not isinstance(pip_line, str):
                    raise ValueError(f"{origin}: a pip entry must be a string, got {pip_line!r}")
                parsed = parse_requirement_line(pip_line, "pip")
                if parsed:
                    requirements.append(parsed)
        else:
            raise ValueError(f"{origin}: unsupported entry in dependencies: {entry!r}")
    if not requirements:
        raise ValueError(f"{origin}: no packages found")
    return (str(data.get("name", "")), requirements)


def _parse_yaml_environment(text: str, origin: str) -> Tuple[str, List[Requirement]]:
    """The `environment.yml` subset: `name`, `dependencies`, and the nested `pip:` list.

    Anything else -- anchors, flow style, multiple documents -- is refused, because a parser that
    half-understands YAML builds an environment nobody asked for. `channels:`, `variables:` and
    other sections are ignored, since they do not describe packages to install.
    """
    name = ""
    requirements = []  # type: List[Requirement]
    section = ""
    in_pip = False
    for number, raw in enumerate(text.splitlines(), start=1):
        line = raw.split("#")[0].rstrip()
        if not line.strip():
            continue
        if line.lstrip().startswith("- "):
            if section != "dependencies":
                continue  # a channels: or variables: list item
            item = line.strip()[2:].strip()
            indent = len(line) - len(line.lstrip())
            if item.endswith(":"):  # `- pip:` opens the pip list; `- pip` is the package itself
                in_pip = item.rstrip(":") == "pip"
                continue
            if ": " in item and not item.startswith(("=", "<", ">", "!", "~")):
                continue  # a nested mapping inside a list item is not a package
            parsed = parse_requirement_line(item, "pip" if in_pip and indent >= 4 else "conda")
            if not (in_pip and indent >= 4):
                in_pip = False
            if parsed:
                requirements.append(parsed)
            continue
        if ":" not in line:
            raise ValueError(f"{origin}:{number}: expected `key: value`, got {raw.strip()!r}")
        key, _, value = line.partition(":")
        key = key.strip()
        if line.startswith((" ", "\t")):
            continue  # a nested mapping inside a section we ignore
        in_pip = False
        if key == "name":
            name = value.strip()
            section = ""
        elif key == "dependencies":
            section = "dependencies"
        else:
            section = key
    if not requirements:
        raise ValueError(f"{origin}: no packages found")
    return (name, requirements)


def classify(
    requirements: List[Requirement], image: Dict[str, str], allow_shadow: List[str]
) -> Plan:
    """The rule that decides the whole tool: install the delta, refuse the shadows.

    `image` maps normalized package name -> the version the image already has. A package the image
    satisfies is left alone. A package the image does not have is installed. A package the image
    has at a version the environment does not accept is a conflict, because a layer can only
    shadow it -- and shadowing the image's numpy is how a working ROCm job breaks.
    """
    allowed = {normalize_name(name) for name in allow_shadow}
    plan = Plan()
    for requirement in requirements:
        key = requirement.key
        if requirement.name.startswith("_") or key in NON_LAYERABLE:
            plan.conflicts.append(
                Conflict(
                    package=requirement.name,
                    kind="non-pip",
                    requested=requirement.spec,
                    image_version=image.get(key, ""),
                    why=(
                        "this is the environment's own runtime or a conda system package, and a "
                        "layer cannot provide it. Layer only what you ADD to the image; a whole "
                        "conda environment is route 2 or 3 -- build your own container."
                    ),
                )
            )
            continue
        image_version = image.get(key)
        if image_version is None:
            if key in STACK_PACKAGES and key not in allowed:
                plan.conflicts.append(
                    Conflict(
                        package=requirement.name,
                        kind="shadow-stack",
                        requested=requirement.spec,
                        image_version="",
                        why=(
                            "the image does not ship this, but it belongs to the accelerator stack; "
                            "installing it into the layer would shadow what the image's torch was "
                            "built against."
                        ),
                    )
                )
            else:
                if key in STACK_PACKAGES:
                    plan.allowed_shadow.append(requirement.name)
                plan.missing.append(requirement)
            continue
        if satisfies(image_version, requirement.spec):
            plan.satisfied.append((requirement, image_version))
            continue
        if key in allowed:
            plan.allowed_shadow.append(requirement.name)
            plan.missing.append(requirement)
            continue
        plan.conflicts.append(
            Conflict(
                package=requirement.name,
                kind="version-drift",
                requested=requirement.spec,
                image_version=image_version,
                why=(
                    f"the image has {image_version}, which does not satisfy "
                    f"{requirement.spec or 'any'}; installing the requested version into the layer "
                    f"shadows the image's copy. Use --allow-shadow {requirement.name} if you have "
                    "decided that is what you want."
                ),
            )
        )
    return plan


