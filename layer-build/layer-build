class Options(object):
    """The CLI's settled inputs. A plain class: the tool must run on a login node's python3."""

    def __init__(self, base, env_file, layer_id, out, python, allow_shadow, dry_run,
                 as_json, export_to, base_sha256, timeout, keep_stage):
        self.base = base
        self.env_file = env_file
        self.layer_id = layer_id
        self.out = out
        self.python = python
        self.allow_shadow = allow_shadow
        self.dry_run = dry_run
        self.as_json = as_json
        self.export_to = export_to
        self.base_sha256 = base_sha256
        self.timeout = timeout
        self.keep_stage = keep_stage


def record_export(path: Path, value: str) -> Tuple[bool, str]:
    """Point an env file's MODEL_LAYER line at this layer, verified before it is installed.

    The file is sourced by the user's shells, so it is executable text: the rewrite is installed
    only after a subshell has sourced it and printed the value back. A file that exits early, or a
    value the shell cannot round-trip, is refused rather than half-written. The layer is already
    published by this point, so a failure here is a message, never a failed build.
    """
    line = f"export MODEL_LAYER={shlex.quote(value)}"
    if path.is_symlink() or not path.is_file() or not os.access(path, os.R_OK | os.W_OK):
        return False, f"no writable, regular env file at {path}"
    original = path.read_text()
    lines = original.splitlines()
    if any(existing.startswith("export MODEL_LAYER=") for existing in lines):
        rewritten = "\n".join(
            line if existing.startswith("export MODEL_LAYER=") else existing for existing in lines
        )
    else:
        rewritten = original.rstrip("\n") + "\n\n" + line
    mode = path.stat().st_mode & 0o7777

    handle = tempfile.NamedTemporaryFile("w", dir=str(path.parent), prefix=path.name + ".", delete=False)
    try:
        with handle:
            handle.write(rewritten + "\n")
        temp = Path(handle.name)
        os.chmod(temp, mode)
        verify = subprocess.run(
            [
                "bash",
                "-c",
                # mirror the consumer: workflow/profiles/lumi-g/train.sbatch sources env.sh
                # under `set -euo pipefail`, so the verification does too, and captures the status
                # explicitly because a sourced file may turn errexit off for itself.
                'set -euo pipefail; . "$1" >/dev/null 2>&1; st=$?; printf "V=%s S=%s" "${MODEL_LAYER:-}" "$st"',
                "_",
                str(temp),
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            universal_newlines=True,
            check=False,
        )
        # The status of the source command is captured explicitly: a file may run `set +e`
        # itself, so errexit in the verification shell is not a policy we can rely on.
        if verify.stdout != f"V={value} S=0":
            return False, f"{path} did not source cleanly and round-trip the value; left as it was"
        temp.replace(path)
    finally:
        if Path(handle.name).exists():
            Path(handle.name).unlink()  # only the temporary file this function created
    return True, line


def publish(partial: Path, sqsh: Path, freeze_text: str, manifest_text: str) -> Dict[str, str]:
    """Turn the packed `.partial` layer and its records into the published set.

    The layer is the commit marker: the records are renamed into place first and the layer last, so a
    layer that exists always has complete records beside it. An interrupted publication can leave
    final records beside a `.partial` layer, and any of them blocks reuse of that layer id -- which
    is what makes the failure safe instead of silent.
    """
    artifacts = {
        "layer": str(sqsh),
        "freeze": str(sqsh.with_name(sqsh.name + ".freeze.txt")),
        "manifest": str(sqsh.with_name(sqsh.name + ".manifest.txt")),
        "sha256": str(sqsh.with_name(sqsh.name + ".sha256")),
    }
    staged = {name: Path(f"{path}.partial") for name, path in artifacts.items()}
    staged["freeze"].write_text(freeze_text)
    staged["manifest"].write_text(manifest_text)
    digests = run(["sha256sum", str(partial), str(staged["freeze"]), str(staged["manifest"])])
    for name in ("layer", "freeze", "manifest"):  # the records name the final paths
        digests = digests.replace(str(staged[name]), str(artifacts[name]))
    staged["sha256"].write_text(digests)
    staged["freeze"].replace(artifacts["freeze"])
    staged["manifest"].replace(artifacts["manifest"])
    staged["sha256"].replace(artifacts["sha256"])
    partial.replace(sqsh)
    return artifacts


def build(options: Options) -> Tuple[Plan, Dict]:
    base = Path(options.base)
    if not base.is_file():
        raise ToolError(f"no base image at {base}", EXIT_USAGE)
    if options.base_sha256:
        # A pin whose hash is never checked is not a pin: read the whole image, once, and stop
        # if it is not the image step 2 recorded. Optional, because step 2 makes it optional.
        sha_file = Path(options.base_sha256)
        if not sha_file.is_file():
            raise ToolError(f"no checksum file at {sha_file}", EXIT_USAGE)
        recorded = sha_file.read_text().split()
        expected = recorded[0] if recorded else ""
        if not re.fullmatch(r"[0-9a-fA-F]{64}", expected):
            raise ToolError(f"{sha_file} does not start with a sha256 digest", EXIT_USAGE)
        actual = run(["sha256sum", options.base], timeout=options.timeout).split()[0]
        if actual.lower() != expected.lower():
            named = recorded[-1] if len(recorded) > 1 else "?"
            raise ToolError(
                "the base image is not the pinned one:\n"
                f"  {options.base}\n  has    {actual}\n  pinned {expected}\n"
                f"  (the digest comes from {sha_file}, which names {named})",
                EXIT_USAGE,
            )
        base_sha = actual
    else:
        base_sha = "unverified"
    env_name, requirements = parse_environment(read_env_file(options.env_file), options.env_file)

    # Resolve --out now, before any container work: the records must name absolute paths, so that
    # `sha256sum -c` from a job's directory means the same thing as it does here.
    out_dir = Path(options.out).resolve()
    sqsh = out_dir / f"{options.layer_id}.sqsh"
    partial = sqsh.with_name(sqsh.name + ".partial")
    final = [
        sqsh,
        sqsh.with_name(sqsh.name + ".freeze.txt"),
        sqsh.with_name(sqsh.name + ".manifest.txt"),
        sqsh.with_name(sqsh.name + ".sha256"),
    ]
    if any(p.exists() for p in final) or any(Path(f"{p}.partial").exists() for p in final):
        raise ToolError(
            f"{sqsh} or one of its records already exists (or a `.partial` from an interrupted "
            "build). A published layer is immutable: pick a new --id, or move the old one aside.",
            EXIT_USAGE,
        )

    image = image_packages(options.base, options.python)
    plan = classify(requirements, image, options.allow_shadow)

    report: dict = {
        "tool": TOOL,
        "version": VERSION,
        "base_image": options.base,
        "env_file": options.env_file,
        "environment": env_name,
        "layer_id": options.layer_id,
        "python": options.python,
        "image_packages": len(image),
        "satisfied": sorted(r.name for r, _ in plan.satisfied),
        "missing": sorted(r.name for r in plan.missing),
        "allowed_shadow": sorted(plan.allowed_shadow),
        "conflicts": [c.as_dict() for c in plan.conflicts],
    }
    if plan.conflicts:
        raise Conflicts(plan, report)
    if options.dry_run:
        report["status"] = "dry-run"
        return plan, report

    out_dir.mkdir(parents=True, exist_ok=True)

    if options.keep_stage:
        stage_root = out_dir / f"{options.layer_id}.stage"
        if stage_root.exists():
            raise ToolError(
                f"staging directory already exists: {stage_root} -- move it aside, or drop "
                "--keep-stage and let the tool use a fresh one",
                EXIT_USAGE,
            )
        stage_root.mkdir(parents=True)
    else:
        stage_root = Path(tempfile.mkdtemp(prefix="layer-build."))  # node-local /tmp: RAM on a node
    venv = stage_root / "venv"
    venv.mkdir(parents=True, exist_ok=True)  # singularity needs the bind source to exist
    print(f"staging {stage_root}", file=sys.stderr)  # so a failed build leaves a path you can find

    # The image's own `pip check` noise, measured before anything of ours exists.
    base_check = pip_check(options.base, options.python, None)

    print(f"== building {len(plan.missing)} package(s) into {sqsh} ==", file=sys.stderr)
    mount = ["-B", f"{venv}:/user-software:rw"]
    run(
        ["singularity", "exec", "--no-home", *mount, "--pwd", "/", options.base, options.python,
         "-m", "venv", "/user-software", "--system-site-packages"],
        timeout=options.timeout,
    )
    if plan.installable():
        run(
            ["singularity", "exec", "--no-home", *mount, "--pwd", "/", options.base,
             "/user-software/bin/python", "-m", "pip", "install", "--no-cache-dir",
             *plan.installable()],
            timeout=options.timeout,
        )

    # Pack first: every check below runs against the artifact a job will mount, not against the
    # directory it was built from. Testing the directory tests something no job ever sees.
    run(["mksquashfs", str(venv), str(partial), "-noappend", "-processors", "1", "-all-root",
         "-action", "chmod(a+rX) @true"])

    layer_python = ["singularity", "exec", "--no-home", "-B", f"{partial}:/user-software:image-src=/",
                    options.base, "/user-software/bin/python"]

    # The layer must not have changed any part of the image's accelerator stack. This is the
    # check that catches a transitive upgrade pip decided to make on its own.
    after = {normalize_name(e["name"]): e.get("version", "") for e in json.loads(run([*layer_python, "-m", "pip", "list", "--format=json"]))}
    allowed_stack = {normalize_name(name) for name in plan.allowed_shadow}
    drifted = [
        f"{key}: image {value}, layer {after.get(key, 'absent')}"
        for key, value in image.items()
        # A package the user explicitly allowed is excluded here on purpose: the flag means what
        # it says, and the manifest records it.
        if key in STACK_PACKAGES and key not in allowed_stack and after.get(key, "") != value
    ]
    moved = sorted(allowed_stack & {key for key in image if key in STACK_PACKAGES})
    if moved:
        print(
            f"note: the accelerator stack was moved deliberately: {', '.join(moved)} "
            "(recorded in the manifest)",
            file=sys.stderr,
        )
    if drifted:
        raise ToolError(
            "the layer changed part of the image's accelerator stack:\n  " + "\n  ".join(drifted),
            EXIT_CONFLICT,
        )

    # Every requested distribution must be importable from the layer's interpreter.
    names = sorted({r.name for r in plan.missing} | {r.name for r, _ in plan.satisfied})
    try:
        run([*layer_python, "-c", import_probe(names)], timeout=options.timeout)
    except ToolError as exc:
        raise ToolError(f"a requested package is not importable from the layer:\n{exc}", EXIT_BUILD) from exc

    freeze = run([*layer_python, "-m", "pip", "freeze", "--all"])

    # The differential gate: did OUR packages add a conflict the image alone does not have?
    # It runs against the packed layer, which is what a job mounts.
    check_regressions(base_check, pip_check(options.base, options.python, str(partial)))
    manifest_text = "\n".join(
        [
            f"layer={sqsh}",
            f"layer_id={options.layer_id}",
            f"tool={TOOL} {VERSION}",
            f"base_image={options.base}",
            f"base_image_sha256={base_sha}",
            f"requirements={options.env_file}",
            f"created={datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')}",
            f"installed={','.join(plan.installable()) or '(none)'}",
            f"allow_shadow={','.join(sorted(plan.allowed_shadow)) or '(none)'}",
            "",
        ]
    )
    artifacts = publish(partial, sqsh, freeze, manifest_text)
    if not options.keep_stage:
        shutil.rmtree(stage_root, ignore_errors=True)

    report["artifacts"] = artifacts
    report["status"] = "built"
    if options.export_to:
        ok, detail = record_export(Path(options.export_to), str(sqsh))
        report["export_to"] = {"file": options.export_to, "ok": ok, "detail": detail}
    return plan, report


class Conflicts(ToolError):
    """Refused: the plan would shadow the image. Carries the report so `--json` stays truthful."""

    def __init__(self, plan: Plan, report: dict):
        super().__init__(
            f"{len(plan.conflicts)} conflict(s) -- nothing was built. Read the reasons below; "
            "--allow-shadow PKG overrides one deliberately.",
            EXIT_CONFLICT,
        )
        self.plan = plan
        self.report = report


